# Customer app (Expo). Public values only — never a service key.
# Local stack: a phone on your LAN needs your computer's LAN IP instead of 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Web app origin: hosts /captcha (Turnstile for the app) and is the share / universal-link domain
EXPO_PUBLIC_WEB_URL=http://127.0.0.1:3000
# Profile → Contact Support (https://wa.me/961XXXXXXXX or mailto:…). Empty = shown as not configured yet
EXPO_PUBLIC_SUPPORT_URL=

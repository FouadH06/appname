# Copy to .env.local. Values for the local stack come from `pnpm db:start` output.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile site key. Local/CI: Cloudflare's always-pass test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Enables /lab/* test pages (phone + in-app browser checks). Never true in production.
NEXT_PUBLIC_ENABLE_LAB=false

-- Shared pgTAP fixtures. Include from a test file (inside its transaction) with:
--   \ir ../helpers/fixtures.psql
-- Everything created here is rolled back with the test's transaction.
-- The .psql extension keeps the test runner from executing this file on its own.

create schema tests;
grant usage on schema tests to anon, authenticated;

create table tests.ids (name text primary key, id uuid not null);
grant select on tests.ids to anon, authenticated;

create function tests.id(p_name text) returns uuid language sql stable as
  $$ select id from tests.ids where name = p_name $$;

-- auth user (+ profile via the sync trigger). GoTrue stores phones without '+'.
create function tests.new_user(p_name text, p_phone text default null) returns uuid language plpgsql as $$
declare v uuid := gen_random_uuid();
begin
  insert into auth.users (id, aud, role, phone, phone_confirmed_at, created_at, updated_at)
  values (v, 'authenticated', 'authenticated', p_phone,
          case when p_phone is not null then now() end, now(), now());
  insert into tests.ids values (p_name, v);
  return v;
end $$;

-- Switch to an authenticated session for a named user
create function tests.act_as(p_name text, p_aal text default 'aal1', p_anonymous boolean default false)
returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', tests.id(p_name), 'role', 'authenticated', 'aal', p_aal,
                      'is_anonymous', p_anonymous)::text, true);
  perform set_config('role', 'authenticated', true);
end $$;

create function tests.as_anon() returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', '', true);
  perform set_config('role', 'anon', true);
end $$;

-- Back to the fixture owner (hosted CLI connects as a temporary role, so be explicit)
create function tests.as_postgres() returns void language plpgsql as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end $$;

-- A live barber in Hazmieh with a primary location and an owner. Registers <key>, <key>_loc.
create function tests.new_business(p_key text, p_owner text) returns uuid language plpgsql as $$
declare v_biz uuid; v_loc uuid;
begin
  insert into public.businesses (slug, name, primary_category_id, status)
  select replace(p_key, '_', '-') || '-test', 'Business ' || p_key, c.id, 'live'
  from public.categories c where c.slug = 'barber'
  returning id into v_biz;
  insert into tests.ids values (p_key, v_biz);

  insert into public.business_locations (business_id, area_id, address_line, geo, status)
  select v_biz, a.id, 'Main street', a.centroid, 'live' from public.areas a where a.slug = 'hazmieh'
  returning id into v_loc;
  insert into tests.ids values (p_key || '_loc', v_loc);

  insert into public.business_members (business_id, user_id, role) values (v_biz, tests.id(p_owner), 'owner');
  return v_biz;
end $$;

create function tests.add_member(p_biz text, p_user text, p_role public.business_role) returns void
language sql as $$
  insert into public.business_members (business_id, user_id, role) values (tests.id(p_biz), tests.id(p_user), p_role)
$$;

-- Staff member linked to the business's primary location. Registers <name>.
create function tests.new_staff(p_biz text, p_name text, p_user text default null,
                                p_public boolean default true, p_any boolean default true)
returns uuid language plpgsql as $$
declare v uuid;
begin
  insert into public.staff_members (business_id, user_id, display_name, slug, publicly_bookable, accepts_any_assignment)
  values (tests.id(p_biz), case when p_user is not null then tests.id(p_user) end, p_name,
          lower(regexp_replace(p_name, '[^a-zA-Z0-9]+', '-', 'g')), p_public, p_any)
  returning id into v;
  insert into public.staff_locations (staff_id, location_id, business_id)
  values (v, tests.id(p_biz || '_loc'), tests.id(p_biz));
  insert into tests.ids values (p_name, v);
  return v;
end $$;

-- Fixed-price service mapped to a canonical service. Registers <name>.
create function tests.new_service(p_biz text, p_name text, p_canonical text default 'mens-haircut',
                                  p_price numeric default 15, p_minutes int default 30)
returns uuid language plpgsql as $$
declare v uuid;
begin
  insert into public.services (business_id, canonical_service_id, name, price_type, price_min, duration_min)
  select tests.id(p_biz), c.id, p_name, 'fixed', p_price, p_minutes
  from public.canonical_services c where c.slug = p_canonical
  returning id into v;
  insert into tests.ids values (p_name, v);
  return v;
end $$;

-- ─── M3 booking fixtures ───────────────────────────────────────────────────
-- Instant in Beirut local time: tests.at(date, '10:30')
create function tests.at(p_day date, p_hhmi text) returns timestamptz language sql stable as
  $$ select (p_day::timestamp + p_hhmi::time) at time zone 'Asia/Beirut' $$;

-- Local date n days from today in Beirut
create function tests.day(p_offset int) returns date language sql stable as
  $$ select (now() at time zone 'Asia/Beirut')::date + p_offset $$;

-- Opening hours every day (default 09:00–19:00)
create function tests.open_every_day(p_biz text, p_from int default 540, p_to int default 1140) returns void
language sql as $$
  insert into public.location_hours (location_id, business_id, iso_weekday, start_minute, end_minute)
  select tests.id(p_biz || '_loc'), tests.id(p_biz), d, p_from, p_to from generate_series(1, 7) d
$$;

-- Weekly hours for a staff member every day; optional break
create function tests.staff_every_day(p_biz text, p_staff text, p_from int, p_to int,
                                      p_break_from int default null, p_break_to int default null)
returns void language plpgsql as $$
begin
  if p_break_from is null then
    insert into public.staff_weekly_hours (staff_id, location_id, business_id, iso_weekday, start_minute, end_minute, effective_from)
    select tests.id(p_staff), tests.id(p_biz || '_loc'), tests.id(p_biz), d, p_from, p_to, current_date - 1
    from generate_series(1, 7) d;
  else
    insert into public.staff_weekly_hours (staff_id, location_id, business_id, iso_weekday, start_minute, end_minute, effective_from)
    select tests.id(p_staff), tests.id(p_biz || '_loc'), tests.id(p_biz), d, x.s, x.e, current_date - 1
    from generate_series(1, 7) d cross join (values (p_from, p_break_from), (p_break_to, p_to)) as x(s, e);
  end if;
end $$;

create function tests.link(p_biz text, p_staff text, p_service text) returns void language sql as $$
  insert into public.staff_services (staff_id, service_id, business_id)
  values (tests.id(p_staff), tests.id(p_service), tests.id(p_biz))
$$;

-- A booking written directly (bypassing RPCs) for schema/availability tests
create function tests.raw_booking(p_biz text, p_staff text, p_service text, p_start timestamptz,
                                  p_minutes int default 30, p_status public.booking_status default 'confirmed',
                                  p_buffer_after int default 0)
returns uuid language plpgsql as $$
declare v_bid uuid; v_cust uuid;
begin
  insert into public.business_customers (business_id, display_name, acquired_via)
  values (tests.id(p_biz), 'Raw customer', 'manual') returning id into v_cust;
  insert into public.bookings (business_id, location_id, business_customer_id, status, source, starts_at, ends_at,
                               created_by_kind, confirmed_at, completed_at, hold_token_hash, expires_at)
  values (tests.id(p_biz), tests.id(p_biz || '_loc'), v_cust, p_status,
          case when p_status = 'held' then 'business_link' else 'manual' end::public.booking_source,
          p_start, p_start + make_interval(mins => p_minutes),
          case when p_status = 'held' then 'customer' else 'business' end::public.actor_kind,
          case when p_status = 'confirmed' then now() end,
          case when p_status = 'completed' then now() end,
          case when p_status = 'held' then '\x00'::bytea end,
          case when p_status in ('held', 'pending') then least(now() + interval '5 minutes', p_start) end)
  returning id into v_bid;
  insert into public.booking_items (booking_id, business_id, location_id, service_id, canonical_service_id, staff_id,
                                    selection_mode, starts_at, ends_at, buffer_after_min, occupied, duration_min,
                                    price_type, price_min)
  select v_bid, tests.id(p_biz), tests.id(p_biz || '_loc'), s.id, s.canonical_service_id, tests.id(p_staff),
         'business', p_start, p_start + make_interval(mins => p_minutes), p_buffer_after,
         tstzrange(p_start, p_start + make_interval(mins => p_minutes + p_buffer_after), '[)'), p_minutes,
         'fixed', 10
  from public.services s where s.id = tests.id(p_service);
  return v_bid;
end $$;

grant execute on all functions in schema tests to anon, authenticated;

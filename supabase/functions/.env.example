# Edge Function secrets for STAGING / PRODUCTION (`supabase secrets set --env-file <file>`).
# Local development uses supabase/config.toml [edge_runtime.secrets] (log mode) instead.
# Never commit real values.

# ── Send SMS hook (Auth → auth-send-sms) ── same value as Dashboard → Auth → Hooks → Send SMS
SEND_SMS_HOOK_SECRETS=v1,whsec_...

# ── Routing ──
SMS_ALLOWED_PREFIXES=+961            # comma-separated E.164 prefixes allowed to receive SMS
OTP_BRAND=APP_NAME                   # name in the SMS text
OTP_WEB_DOMAIN=                      # e.g. staging.example.com → adds the Web OTP line for Android autofill

# ── WhatsApp Cloud API (primary) ── leave unset until Meta approves the number: codes go by SMS
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=               # approved AUTHENTICATION template with a copy-code button
WHATSAPP_OTP_LANG_EN=en
WHATSAPP_OTP_LANG_AR=ar
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_APP_SECRET=                 # verifies webhook signatures (whatsapp-webhook)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=       # any random string; also entered in the Meta app webhook settings

# ── Twilio SMS (fallback) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=        # preferred; or TWILIO_FROM=+1...
TWILIO_STATUS_CALLBACK_URL=https://<ref>.supabase.co/functions/v1/twilio-status

# ── Booking messages (M7: notify-dispatch) ── same WhatsApp / Twilio accounts as above
NOTIFY_DISPATCH_SECRET=              # random; also stored in Vault as notify_dispatch_secret (pg_cron sends it)
# Vault (SQL editor): select vault.create_secret('https://<ref>.supabase.co/functions/v1/notify-dispatch', 'notify_dispatch_url');
#                     select vault.create_secret('<NOTIFY_DISPATCH_SECRET>', 'notify_dispatch_secret');
# Links in messages: update private.app_settings set value = 'https://<web domain>' where key = 'web_base_url';

# ── Later milestones ──
# IP_HASH_SECRET=                    # M7

# ─── M9 · review moderation + translations (moderate) ───────────────────────
# Shared secret for pg_cron → moderate. Vault (SQL editor):
#   select vault.create_secret('https://<ref>.supabase.co/functions/v1/moderate', 'moderate_url');
#   select vault.create_secret('<MODERATE_SECRET>', 'moderate_secret');
MODERATE_SECRET=
# Claude for text classification and translations. Without a key: keyword classifier, strict outside
# the local stack (explicit rejects still reject, every other comment waits for a moderator).
ANTHROPIC_API_KEY=
# Optional: model id (default claude-sonnet-5; claude-opus-5-5 if Sonnet fails the eval gate);
# MODERATION_MODE=llm|heuristic (default: llm when a key is set)
LLM_MODEL=
MODERATION_MODE=
# true only after the chosen model passes the blind eval gate (0 harmful held-out comments published);
# until then Claude's approvals also wait for a moderator
MODERATION_AUTO_PUBLISH=false

# ─── M10 · customer photos (media-orchestrator) ─────────────────────────────
# pg_cron calls media-orchestrator every minute while a media queue has work; also in Vault:
#   select vault.create_secret('https://<ref>.supabase.co/functions/v1/media-orchestrator', 'media_orchestrator_url');
#   select vault.create_secret('<MEDIA_ORCHESTRATOR_SECRET>', 'media_orchestrator_secret');
MEDIA_ORCHESTRATOR_SECRET=
# Image classification uses ANTHROPIC_API_KEY (above). Without it every photo waits for a moderator.
# Optional model id for images (default: LLM_MODEL, then claude-sonnet-5)
MEDIA_LLM_MODEL=
# true only after the labelled image eval passes (≥ 90 % of automatic decisions correct, 0 falsely
# public); until then Claude's approvals also wait for a moderator
MEDIA_AUTO_PUBLISH=false
# The transform worker (apps/media-worker, Docker) runs outside Supabase with its own env:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY (set on the worker host only, never in Git), PORT=8790
# ─── M13 · app push (notify-dispatch → Expo push service) ───────────────────
# Optional: Expo access token with "enhanced push security" enabled for the project. Push works without
# it once the app has an EAS project id; without registered devices nothing is sent by push.
EXPO_ACCESS_TOKEN=

# Target runtime is Node 24 LTS (.nvmrc, CI). Not strict, so newer local Node versions still
# install (some deps exclude odd-numbered Node releases); pnpm prints a warning instead.
engine-strict=false
auto-install-peers=true
# Expo / React Native tooling still expects some hoisting in pnpm monorepos.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
